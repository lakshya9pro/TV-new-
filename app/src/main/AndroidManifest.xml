<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Touchscreen is optional so the app runs on both Android TV and Phones -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Leanback is optional (required="false") so it can install on standard Android phones -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:theme="@style/Theme.TVLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TVLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Surfacing app icon on both Standard Phone Launchers and Android TV Leanback -->
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.TVLauncher" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.TVLauncher" />

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TVLauncher" />

        <service
            android:name=".test.ServerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
