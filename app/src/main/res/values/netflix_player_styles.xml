<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SheetSlideAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/slide_up_in</item>
        <item name="android:windowExitAnimation">@anim/slide_down_out</item>
    </style>

    <!--
      Theme for the reusable Netflix-style bottom sheet (see PlayerActivity.showNetflixSheet).
      Floating + transparent window background so our own rounded-corner drawable shows
      through, anchored to the bottom of the screen, with a dim scrim behind it.
    -->
    <style name="NetflixBottomSheetDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@style/SheetSlideAnimation</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

</resources>
